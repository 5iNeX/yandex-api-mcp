FROM node:22-bookworm-slim AS node-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY core/package.json core/package-lock.json core/tsconfig.json ./core/
RUN cd core && npm ci --ignore-scripts
COPY core/src ./core/src
RUN cd core && npm run build && npm prune --omit=dev

FROM python:3.13-slim
WORKDIR /app
COPY --from=node-build /usr/local/bin/node /usr/local/bin/node
COPY --from=node-build /app/node_modules ./node_modules
COPY --from=node-build /app/core/node_modules ./core/node_modules
COPY --from=node-build /app/core/dist ./core/dist
COPY package.json ./
COPY gateway ./gateway
COPY pyproject.toml README.md ./
COPY src ./src
COPY docs/templates/dashboard-template-option1-2026-01-28.html ./docs/templates/dashboard-template-option1-2026-01-28.html
ARG MCP_EDITION=public
ARG MCP_PUBLIC_READONLY=true
RUN pip install --no-cache-dir . "anyio>=4,<5" \
    && printf '%s' "${MCP_EDITION}" > /app/.mcp_edition \
    && useradd -u 10001 -m -s /usr/sbin/nologin mcp \
    && mkdir /data && chown 10001:10001 /data
ENV PYTHONUNBUFFERED=1 MCP_EDITION=${MCP_EDITION} MCP_PUBLIC_READONLY=${MCP_PUBLIC_READONLY}
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/healthz', timeout=3).close()"
CMD ["node", "gateway/index.mjs", "--sse"]
